# --- Database (optional) ---
# The app runs without a database. Set this to persist contact
# submissions, newsletter subscribers, and project analytics.
# Required only for `pnpm db:migrate` / `pnpm db:seed`.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# --- Email (optional) ---
# Set to actually send contact-form emails. Without it, submitContact
# still validates and (with DATABASE_URL) persists, but skips emailing.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL="hello@devina.dev"

# --- Public (bundled into the client) ---
# Vite exposes PUBLIC_* env vars to the client bundle.
PUBLIC_URL="https://devina.dev"
